# 复制为 .env 后填写。.env* 已在 .gitignore 中，不会被提交。

# /mcp 与 /api/mcp 的访问密钥。
# 未配置时该端点一律返回 401（fail-closed，这是有意设计）。
# 生成示例：node -e "console.log(crypto.randomUUID().replace(/-/g,''))"
MCP_API_KEY=

# 本地开发时 wrangler / miniflare 的日志与状态目录（非敏感，可保持默认）
# WRANGLER_WRITE_LOGS=false
# WRANGLER_LOG_PATH=.wrangler/logs
# MINIFLARE_REGISTRY_PATH=.wrangler/registry

# 站点自身的公开地址（用于 og:image 等绝对地址；不设置则回落到已部署的默认域名）
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# 固定收盘窗口预测任务专用密钥（与 MCP 密钥分开；缺少时任务返回 401）
FORECAST_JOB_KEY=
# 调度脚本调用的站点地址；本地默认 http://localhost:3000
# FORECAST_SITE_URL=http://localhost:3000

# Node 托管可选：必须指向持久磁盘；Cloudflare 使用 D1，无需设置
# ANALYST_SQLITE_PATH=.data/analyst.sqlite
